# GrimmLink Adapter Configuration
# --------------------------------

# Host and port for the standalone adapter server
ADAPTER_HOST=0.0.0.0
ADAPTER_PORT=8085

# Base URL to unmodified Official Grimmory HTTP API
# e.g., http://localhost:6060 or http://grimmory:6060 in Docker network
GRIMMORY_BASE_URL=http://localhost:6060

# Local SQLite storage for token cache, hash cache, idempotency, and outbox
SQLITE_DB_PATH=data/grimmlink_adapter.db

# Logging level: DEBUG, INFO, WARNING, ERROR
# SECURITY NOTE: Sensitive tokens, passwords, and MD5 keys are NEVER logged at any log level.
LOG_LEVEL=INFO

# Upstream HTTP client configuration
OFFICIAL_CLIENT_TIMEOUT=15.0
OFFICIAL_CLIENT_MAX_RETRIES=3
