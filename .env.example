# GrimmLink Adapter Configuration
# --------------------------------

# Host and port for the standalone adapter server
ADAPTER_HOST=0.0.0.0
ADAPTER_PORT=8085
# Compose example: bind published ports only to the Pi's LAN interface.
# Set this to a reserved/static LAN IPv4 address before starting Compose.
LAN_BIND_IP=

# Base URL to unmodified Official Grimmory HTTP API
# e.g., http://localhost:6060 or http://grimmory:6060 in Docker network
GRIMMORY_BASE_URL=http://localhost:6060

# Required for first-time hash resolution on stock Grimmory when the Adapter
# has no verified book mapping yet. Enable only after provisioning a dedicated
# SELECT-only account and restricting Adapter-to-DB network access.
GRIMMORY_DB_ENABLED=false
GRIMMORY_DB_HOST=
GRIMMORY_DB_PORT=3306
GRIMMORY_DB_NAME=grimmory
GRIMMORY_DB_USER=
GRIMMORY_DB_PASSWORD=
# Set when MariaDB TLS is configured; leave empty only on a trusted private network.
GRIMMORY_DB_SSL_CA=
GRIMMORY_DB_CONNECT_TIMEOUT=5.0
GRIMMORY_DB_QUERY_TIMEOUT=15.0

# Local SQLite storage for token cache, hash cache, idempotency, and outbox
SQLITE_DB_PATH=data/grimmlink_adapter.db

# Logging level: DEBUG, INFO, WARNING, ERROR
# SECURITY NOTE: Sensitive tokens, passwords, and MD5 keys are NEVER logged at any log level.
LOG_LEVEL=INFO

# Upstream HTTP client configuration
OFFICIAL_CLIENT_TIMEOUT=15.0
OFFICIAL_CLIENT_MAX_RETRIES=3

# Metadata Ingestion (Session 03A)
# Options: api_only, api_preferred, sidecar_only
METADATA_INGESTION_MODE=api_preferred
METADATA_FALLBACK=sidecar
METADATA_IMPORT_ROOTS=[]
# Pi4 Compose example (set the real host mount; enumerate mapped roots inside Adapter):
# NAS_BOOKS_ROOT=/mnt/nas/books
# METADATA_IMPORT_ROOTS=["/imports/novels","/imports/manga"]
LOCAL_METADATA_MAX_SOURCE_BYTES=2097152
METADATA_WORKER_ENABLED=true
METADATA_MAX_BOOKS_PER_RUN=50000
# Optional key path. Default: next to SQLite, with .metadata.key suffix.
# Persist/back up the key with the Adapter DB, separately from read-only NAS books.
# METADATA_KEY_FILE=/app/data/grimmlink_adapter.metadata.key

# Local/LAN metadata UI discovery
MDNS_ENABLED=true
MDNS_HOSTNAME=grimmlink.local
MDNS_SERVICE_NAME=GrimmLink Adapter
# Native/host networking can leave this blank for automatic LAN address detection.
# The Compose example sets MDNS_IPV4 from LAN_BIND_IP automatically.
MDNS_IPV4=
