# GrimmLink Adapter Configuration
# --------------------------------

# Host and port for the standalone adapter server
ADAPTER_HOST=0.0.0.0
ADAPTER_PORT=8085

# Base URL to unmodified Official Grimmory HTTP API
# e.g., http://localhost:6060 or http://grimmory:6060 in Docker network
GRIMMORY_BASE_URL=http://localhost:6060

# Optional exact-hash identity source in Official Grimmory MariaDB.
# Enable only after provisioning a dedicated SELECT-only account and placing
# the Adapter on a network restricted to the Grimmory DB.
GRIMMORY_DB_ENABLED=false
GRIMMORY_DB_HOST=
GRIMMORY_DB_PORT=3306
GRIMMORY_DB_NAME=grimmory
GRIMMORY_DB_USER=
GRIMMORY_DB_PASSWORD=
# Set when MariaDB TLS is configured; leave empty only on a trusted private network.
GRIMMORY_DB_SSL_CA=
GRIMMORY_DB_CONNECT_TIMEOUT=5.0
GRIMMORY_DB_QUERY_TIMEOUT=15.0

# Local SQLite storage for token cache, hash cache, idempotency, and outbox
SQLITE_DB_PATH=data/grimmlink_adapter.db

# Logging level: DEBUG, INFO, WARNING, ERROR
# SECURITY NOTE: Sensitive tokens, passwords, and MD5 keys are NEVER logged at any log level.
LOG_LEVEL=INFO

# Upstream HTTP client configuration
OFFICIAL_CLIENT_TIMEOUT=15.0
OFFICIAL_CLIENT_MAX_RETRIES=3

# Metadata Ingestion (Session 03A)
# Options: api_only, api_preferred, sidecar_only
METADATA_INGESTION_MODE=api_preferred
METADATA_FALLBACK=sidecar
